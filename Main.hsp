#cmpopt optcode 1
#const WINX 640
#const WINY 480
#const CX WINX / 2.0
#const CY WINY / 2.0
#const SCALE 40.0

title "EquationFight"
screen 0, WINX, WINY

newcom sc, "MSScriptControl.ScriptControl"
sc("Language") = "JScript"

expr = "sin(x) * 2 + cos(x * 3)"
replacedExpr = ""

comres res

*titleScene
	gosub *replaceFunctionString
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY

	; スタートボタン
	color 255, 0, 0
	boxf CX - 50, CY + 20, CX + 50, CY + 50
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("START") * 6.25, CY + 25
	mes "START"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY + 20 <= mousey & mousey <= CY + 50 {
		onclick *main
	}

	; Quitボタン
	color 255, 0, 0
	boxf CX - 50, CY + 70, CX + 50, CY + 100
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("QUIT") * 6.25, CY + 75
	mes "QUIT"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
		onclick *endGame
	}
	redraw 1
	wait 16.6
	
	goto *titleScene

*main
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY
	
	color 255, 0, 0
	first = 1
	repeat WINX
		x = double(cnt - CX) / SCALE

		; JScriptで変数xへ代入
		sc->"ExecuteStatement" "var x = " + strf("%f", x) + ";"

		; 数式をJScript側で評価してyへ代入
		sc->"Eval" replacedExpr
		y = double(res)
	
		py = CY - y * SCALE
		if 0 <= py & py <= WINY {
			if first {
				pos cnt, py
				first = 0
			} else {
				line cnt, py
			}
		} else {
			first = 1
		}
	loop
	font msgothic, 16
	pos 0, 0: color 0, 0, 0
	mes "eq: " + expr
	redraw 1
	wait 16.6

	goto *main

*endGame
	end

*replaceFunctionString
	replacedExpr = expr
	strrep replacedExpr, "sin", "Math.sin"
	strrep replacedExpr, "cos", "Math.cos"
	return
