#cmpopt optcode 1

#include "user32.as"

#const WINX 640
#const WINY 480
#const CX WINX / 2.0
#const CY WINY / 2.0
#const SCALE 40.0
#const NUM_FUNCS 5

title "EquationFight"
screen 0, WINX, WINY

newcom sc, "MSScriptControl.ScriptControl"
sc("Language") = "JScript"

compExpr = ""
expr = "sin(x) * 2 + cos(x * 3)"
replacedExpr = ""
replacedCompExpr = ""

comres res

loopTimes = 0

sdim funcs, 64, NUM_FUNCS
funcs.0 = "sin(x)"
funcs.1 = "cos(x)"
funcs.2 = "tan(x)"
funcs.3 = "log(abs(x))"
funcs.4 = "sqrt(abs(x))"

randomize

*titleScene
	gosub *replaceFunctionString
	redraw 0
	
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY

	font msgothic, 50
	color 120, 0, 0 : pos 10, 10
	mes "EquationFight"
	
	; スタートボタン
	color 255, 0, 0
	boxf CX - 50, CY + 20, CX + 50, CY + 50
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("START") * 6.25, CY + 25
	mes "START"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY + 20 <= mousey & mousey <= CY + 50 {
		onclick *inputScene
	}

	; Quitボタン
	color 255, 0, 0
	boxf CX - 50, CY + 70, CX + 50, CY + 100
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("QUIT") * 6.25, CY + 75
	mes "QUIT"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
		onclick *endGame
	}
	redraw 1
	wait 16.6
	
	goto *titleScene

*inputScene
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY

	; 決定
	color 255, 0, 0
	boxf CX - 50, CY + 70, CX + 50, CY + 100
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("SUBMIT") * 6.25, CY + 75
	mes "SUBMIT"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
		gosub *randomChoiceEquation
		gosub *replaceFunctionString
		onclick *hideInput
	}
	
	pos CX - 250, 40
	input expr, 500, 30, 0
	
	redraw 1
	stop

; inputオブジェクトの削除
*hideInput
	clrobj
	goto *mainScene

*mainScene
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY
	
	firstPlayer = 1

	; プレイヤーの曲線を描画
	repeat WINX
		color 255, 0, 0
		x = double(cnt - CX) / SCALE

		; JScriptで変数xへ代入
		sc->"ExecuteStatement" "var x = " + strf("%f", x) + ";"

		; 数式をJScript側で評価してyへ代入
		sc->"Eval" replacedExpr
		y = double(res)
	
		playerPy = CY - y * SCALE
		if 0 <= playerPy & playerPy <= WINY {
			if firstPlayer {
				pos cnt, playerPy
				firstPlayer = 0
			} else {
				line cnt, playerPy
			}
		} else {
			firstPlayer = 1
		}
	loop

	firstComp = 1
	
	; コンピュータの曲線を描画
	repeat loopTimes
		color 0, 0, 255
		x = double(cnt - CX) / SCALE

		; JScriptで変数xへ代入
		sc->"ExecuteStatement" "var x = " + strf("%f", x) + ";"

		; 数式をJScript側で評価してyへ代入
		sc->"Eval" replacedCompExpr
		y = double(res)
	
		compPy = CY - y * SCALE
		if 0 <= compPy & compPy <= WINY {
			if firstComp {
				pos cnt, compPy
				firstComp = 0
			} else {
				line cnt, compPy
			}
		} else {
			firstComp = 1
		}
	loop
	
	font msgothic, 16
	pos 0, 0: color 0, 0, 0
	mes "eq: " + expr
	mes "eq: " + compExpr
	redraw 1
	wait 16.6

	loopTimes += 3
	if loopTimes > WINX {
		loopTimes = WINX
	}

	goto *mainScene

*endGame
	end

*replaceFunctionString
	replacedExpr = expr
	strrep replacedExpr, "sin", "Math.sin"
	strrep replacedExpr, "cos", "Math.cos"
	strrep replacedExpr, "tan", "Math.tan"
	strrep replacedExpr, "exp", "Math.exp"
	strrep replacedExpr, "log", "Math.log"
	strrep replacedExpr, "sqrt", "Math.sqrt"
	strrep replacedExpr, "abs", "Math.abs"

	replacedCompExpr = compExpr
	strrep replacedCompExpr, "sin", "Math.sin"
	strrep replacedCompExpr, "cos", "Math.cos"
	strrep replacedCompExpr, "tan", "Math.tan"
	strrep replacedCompExpr, "exp", "Math.exp"
	strrep replacedCompExpr, "log", "Math.log"
	strrep replacedCompExpr, "sqrt", "Math.sqrt"
	strrep replacedCompExpr, "abs", "Math.abs"
	
	return

*randomChoiceEquation
	repeat 3
		idx = rnd(NUM_FUNCS)
		compExpr += strf("+%s", funcs.idx)
	loop
	return
