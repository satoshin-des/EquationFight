#cmpopt optcode 1

#include "user32.as"

#const WINX 640
#const WINY 480
#const CX WINX / 2.0
#const CY WINY / 2.0
#const SCALE 40.0
#const NUM_FUNCS 5

title "EquationFight"
screen 0, WINX, WINY

newcom sc, "MSScriptControl.ScriptControl"
sc("Language") = "JScript"

compExpr = ""
expr = "sin(x) * 2 + cos(x * 3)"
replacedExpr = ""
replacedCompExpr = ""

comres res

loopTimes = 0

sdim funcs, 64, NUM_FUNCS
funcs.0 = "sin"
funcs.1 = "cos"
funcs.2 = "tan"
funcs.3 = "abs"
funcs.4 = ""

ddim playerCurv, WINX
ddim compCurv, WINY

circleX = CX
circleY = CY
isWin = 1

randomize

*titleScene
	gosub *replaceFunctionString
	redraw 0
	
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY

	font msgothic, 50
	color 120, 0, 0 : pos 10, 10
	mes "EquationFight"
	
	; スタートボタン
	color 255, 0, 0
	boxf CX - 50, CY + 20, CX + 50, CY + 50
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("START") * 6.25, CY + 25
	mes "START"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY + 20 <= mousey & mousey <= CY + 50 {
		onclick *inputScene
	}

	; Quitボタン
	color 255, 0, 0
	boxf CX - 50, CY + 70, CX + 50, CY + 100
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("QUIT") * 6.25, CY + 75
	mes "QUIT"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
		onclick *endGame
	}
	
	redraw 1
	await 16.6
	
	goto *titleScene

*inputScene
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY

	; 決定
	color 255, 0, 0
	boxf CX - 50, CY + 70, CX + 50, CY + 100
	color 255, 255, 255
	font msgothic, 25
	pos CX - strlen("SUBMIT") * 6.25, CY + 75
	mes "SUBMIT"
	if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
		loopTimes = 0
		isWin = 1
		compExpr = ""
		gosub *randomChoiceEquation
		gosub *replaceFunctionString
		gosub *StoreCurve
		onclick *hideInput
	}
	
	pos CX - 250, 40
	input expr, 500, 30, 0
	
	redraw 1
	stop

; inputオブジェクトの削除
*hideInput
	clrobj
	goto *mainScene

*mainScene
	redraw 0
	color 255, 255, 255 : boxf
	color 180, 180, 180

	; x軸とy軸
	line 0, CY, WINX, CY
	line CX, 0, CX, WINY
	
	firstPlayer = 1

	; プレイヤーの曲線を描画
	color 255, 0, 0
	repeat WINX
		y = playerCurv.cnt
	
		playerPy = CY - y * SCALE
		if 0 <= playerPy & playerPy <= WINY {
			if firstPlayer {
				pos cnt, playerPy
				firstPlayer = 0
			} else {
				line cnt, playerPy + 1
				line cnt, playerPy
				line cnt, playerPy - 1
			}
		} else {
			firstPlayer = 1
		}
	loop
	
	firstComp = 1
	
	; コンピュータの曲線を描画
	color 0, 0, 255
	repeat loopTimes
		y = compCurv.cnt
	
		compPy = CY - y * SCALE
		if firstComp {
			pos cnt, compPy
			firstComp = 0
		} else {
			line cnt, compPy + 1
			line cnt, compPy
			line cnt, compPy - 1
		}

		dx = cnt - circleX
		dy = compPy - circleY
		if dx * dx + dy * dy < 400 {
			loopTimes = WINX
			isWin = 0
		}
	loop
	
	font msgothic, 16
	pos 0, 0: color 0, 0, 0
	mes strf("player's eq  : %s", expr)
	mes strf("computer's eq: %s", compExpr)

	if loopTimes = WINX {
		font msgothic, 50
		if isWin {
			gosub *ResetCompCurv
			loopTimes = 0
		} else {
			pos CX - strlen("YOU LOSE!!") * 12.5, 20
			mes "YOU LOSE!!"

			; Retryボタン
			color 255, 0, 0
			boxf CX - 50, CY + 70, CX + 50, CY + 100
			color 255, 255, 255
			font msgothic, 25
			pos CX - strlen("RETRY") * 6.25, CY + 75
			mes "RETRY"
			if CX - 50 <= mousex & mousex <= CX + 50 & CY +70 <= mousey & mousey <= CY + 100 {
				onclick *inputScene
			}
		}
	} else {
		; 自機の表示
		circleX = int(mousex)
		y = playerCurv.circleX
		circleY = CY - y * SCALE
	}

	color 255, 0, 0
	circle circleX - 20, circleY - 20, circleX + 20, circleY + 20
	
	redraw 1
	await 16

	loopTimes += 3
	if loopTimes > WINX {
		loopTimes = WINX
	}
	
	goto *mainScene

*endGame
	end

*replaceFunctionString
	replacedExpr = expr
	strrep replacedExpr, "sin", "Math.sin"
	strrep replacedExpr, "cos", "Math.cos"
	strrep replacedExpr, "tan", "Math.tan"
	strrep replacedExpr, "exp", "Math.exp"
	strrep replacedExpr, "log", "Math.log"
	strrep replacedExpr, "sqrt", "Math.sqrt"
	strrep replacedExpr, "abs", "Math.abs"
	strrep replacedExpr, "cbrt", "Math.cbrt"

	replacedCompExpr = compExpr
	strrep replacedCompExpr, "sin", "Math.sin"
	strrep replacedCompExpr, "cos", "Math.cos"
	strrep replacedCompExpr, "tan", "Math.tan"
	strrep replacedCompExpr, "exp", "Math.exp"
	strrep replacedCompExpr, "log", "Math.log"
	strrep replacedCompExpr, "sqrt", "Math.sqrt"
	strrep replacedCompExpr, "abs", "Math.abs"
	strrep replacedCompExpr, "cbrt", "Math.cbrt"
	
	return

*randomChoiceEquation
	idx = rnd(NUM_FUNCS)
	compExpr += strf("+%s(%f*x+(%f))", funcs.idx, double(rnd(500)) * 0.01, double(rnd(200)) * 0.01 - 1)
	compEXpr += strf("+%f", double(rnd(100) - 50) * 0.01)
	return

*StoreCurve
	repeat WINX
		; JScriptで変数xへ代入
		sc->"ExecuteStatement" strf("var x = %f;", double(cnt - CX) / SCALE)
		
		sc->"Eval" replacedExpr
		playerCurv.cnt = double(res)

		sc->"Eval" replacedCompExpr
		compCurv.cnt = double(res)
	loop
	return

*ResetCompCurv
	gosub *randomChoiceEquation
	gosub *replaceFunctionString
	gosub *StoreCurve
	return
